{
  "name": "groc-functions",
  "description": "Firebase Cloud Functions for Pro Grocery",
  "version": "1.0.0",
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:firestore": "tsc -p tsconfig.json && node lib/seed_firestore.js",
    "seed:users": "tsc -p tsconfig.json && node lib/seed_users.js"
  },
  "dependencies": {
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/express": "^4.17.21",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
